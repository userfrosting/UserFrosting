# Docker Compose project and host port settings.

# Select development or production Docker configuration.
DOCKER_MODE=development
COMPOSE_FILE=compose.${DOCKER_MODE}.yaml

# Use a unique project name and host ports for each checkout.
# COMPOSE_PROJECT_NAME=userfrosting

# Docker public ports. Change these if they conflict with other services on your host.
DOCKER_HTTP_PORT=8080
DOCKER_VITE_PORT=5173
DOCKER_MYSQL_PORT=8503
DOCKER_SMTP_PORT=1025
DOCKER_MAILPIT_PORT=8025

# MySQL container settings. Replace passwords before using production mode.
MYSQL_DATABASE=userfrosting
MYSQL_ROOT_PASSWORD=replace-this-before-production
MYSQL_USER=userfrosting
MYSQL_PASSWORD=replace-this-before-production

# Production Memcached memory limit in MiB.
MEMCACHED_MEMORY_LIMIT=128
