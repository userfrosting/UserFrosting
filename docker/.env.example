# Docker Compose project and host port settings.
# Use a unique project name and host ports for each checkout.
COMPOSE_PROJECT_NAME=userfrosting
DOCKER_HTTP_PORT=8080
DOCKER_VITE_PORT=5173
DOCKER_MYSQL_PORT=8503
DOCKER_SMTP_PORT=1025
DOCKER_MAILPIT_PORT=8025

# MySQL container settings.
MYSQL_DATABASE=userfrosting
MYSQL_ROOT_PASSWORD=secret
MYSQL_USER=docker
MYSQL_PASSWORD=secret
