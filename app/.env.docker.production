# Copy this file to app/.env and set values for your deployment.
# Do not commit the resulting app/.env file.
# Compose injects the database connection from MYSQL_* in the project-root .env.

UF_MODE=production

# Mail configuration
MAIL_MAILER=smtp
SMTP_HOST=smtp.example.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Site Administrator"

# Public URI and CSRF secret
URI_PUBLIC=https://example.com
CSRF_SECRET=replace-this-with-a-long-random-secret

# Set Vite to production mode
VITE_DEV_ENABLED=false

# Cache configuration
CACHE_DRIVER=memcached
MEMCACHED_HOST=memcached
