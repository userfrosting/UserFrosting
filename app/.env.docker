# Sample UserFrosting environment variables definition file for Docker environment.
# Note that in production, it is strongly recommended that you set these variables directly in your environment instead.

# UF Configuration mode (debug, default or production)
UF_MODE=debug

# Database configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=userfrosting
DB_USER=docker
DB_PASSWORD=secret

# Mail configuration
MAIL_MAILER=smtp
SMTP_HOST=mailpit
SMTP_USER=relay@example.com
SMTP_PASSWORD=password
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH=false
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Site Administrator"

# Set to the base URI of your site, e.g. http://www.example.com in production.
# If left blank, it will be automatically determined.
URI_PUBLIC=""

# Port for Vite development server. Default is 5173. Change this if you need to run Vite on a different port.
VITE_PORT=5173
