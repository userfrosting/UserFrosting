# Sample UserFrosting environment variables definition file for Docker environment.
# Note that in production, it is strongly recommended that you set these variables directly in your environment instead.
# The database connection is injected by Compose from the project-root .env.

# UF Configuration mode (debug, default or production)
UF_MODE=default

# Mail configuration
MAIL_MAILER=smtp
SMTP_HOST=mailpit
SMTP_USER=relay@example.com
SMTP_PASSWORD=password
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH=false
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Site Administrator"

# Required when CSRF is enabled. Generate a long random value for production.
CSRF_SECRET=""
